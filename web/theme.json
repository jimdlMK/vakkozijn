{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        {
          "name": "Primair",
          "slug": "primary",
          "color": "#000000"
        },
        {
          "name": "Secundair",
          "slug": "secondary",
          "color": "#D0CF00"
        },
        {
          "name": "Wit",
          "slug": "white",
          "color": "#FFFFFF"
        },
        {
          "name": "Achtergrond licht",
          "slug": "background-light",
          "color": "#F7F6F4"
        },
        {
          "name": "Accent",
          "slug": "accent",
          "color": "#DFDE04"
        },
        {
          "name": "Accent donker",
          "slug": "accent-dark",
          "color": "#BEBD12"
        },
        {
          "name": "Donker",
          "slug": "dark",
          "color": "#393232"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "Termina, sans-serif",
          "slug": "heading",
          "name": "Termina"
        },
        {
          "fontFamily": "'Inter', sans-serif",
          "slug": "body",
          "name": "Inter"
        }
      ],
      "fontSizes": [
        {
          "name": "Tag",
          "slug": "tag",
          "size": "9px",
          "lineHeight": "75px",
          "fontWeight": 500,
          "fontColor": "#000000"
        },
        {
          "name": "Klein",
          "slug": "small",
          "size": "13px",
          "lineHeight": "30px",
          "fontWeight": 500,
          "fontColor": "#000000"
        },
        {
          "name": "Normaal",
          "slug": "normal",
          "size": "16px",
          "lineHeight": "30px",
          "fontWeight": 400,
          "fontColor": "#000000"
        },
        {
          "name": "Intro",
          "slug": "intro",
          "size": "20px",
          "lineHeight": "35px",
          "fontWeight": 500,
          "fontColor": "#000000"
        }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "%", "vw"],
      "spacingSizes": [
        { "name": "XS",  "slug": "xs",  "size": "8px"   },
        { "name": "SM",  "slug": "sm",  "size": "16px"  },
        { "name": "MD",  "slug": "md",  "size": "24px"  },
        { "name": "LG",  "slug": "lg",  "size": "32px"  },
        { "name": "XL",  "slug": "xl",  "size": "48px"  },
        { "name": "2XL", "slug": "2xl", "size": "64px"  },
        { "name": "3XL", "slug": "3xl", "size": "96px"  },
        { "name": "4XL", "slug": "4xl", "size": "128px" }
      ]
    },
    "layout": {
      "contentSize": "1400px",
      "wideSize": "1600px",
      "maxwidth": "90%",
      "blockSpacing": "30px"
    },
    "custom": {
      "container-padding": "20px",
      "button-padding-v": "14px",
      "button-padding-h": "28px",
      "logo-width": "238px",
      "logo-height": "35px",
      "link-underline-color": "#D0CF00",
      "link-underline-width": "2px",
      "menu-dot-color": "#D0CF00",
      "menu-dot-size": "5px",
      "menu-dot-height": "4px"
    }
  },
  "styles": {
    "color": {
      "background": "#FFFFFF",
      "text": "#000000"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--normal)",
      "lineHeight": "1.875"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "40px",
          "fontWeight": "500",
          "lineHeight": "1.325",
          "letterSpacing": "0px"
        },
        "color": { "text": "#000000" }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "36px",
          "fontWeight": "500",
          "lineHeight": "1.25",
          "letterSpacing": "0px"
        },
        "color": { "text": "#000000" }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "28px",
          "fontWeight": "500",
          "lineHeight": "1.286",
          "letterSpacing": "0px"
        },
        "color": { "text": "#000000" }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "24px",
          "fontWeight": "500",
          "lineHeight": "1.333",
          "letterSpacing": "0px"
        },
        "color": { "text": "#000000" }
      },
      "h5": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "20px",
          "fontWeight": "500",
          "lineHeight": "1.4",
          "letterSpacing": "0px"
        },
        "color": { "text": "#000000" }
      },
      "h6": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontSize": "16px",
          "fontWeight": "500",
          "lineHeight": "1.5",
          "letterSpacing": "0px"
        },
        "color": { "text": "#000000" }
      },
      "link": {
        "color": { "text": "#000000" },
        ":hover": {
          "color": { "text": "#D0CF00" }
        }
      },
      "button": {
        "color": {
          "background": "#D0CF00",
          "text": "#000000"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "var(--wp--preset--font-size--normal)",
          "fontWeight": "400",
          "lineHeight": "1.875",
          "textDecoration": "none"
        },
        "spacing": {
          "padding": {
            "top": "14px",
            "bottom": "14px",
            "left": "28px",
            "right": "28px"
          }
        },
        "border": {
          "radius": "0px"
        },
        ":hover": {
          "color": {
            "background": "#DFDE04",
            "text": "#000000"
          }
        }
      }
    }
  }
}
